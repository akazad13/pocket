{
  "permissions": {
    "allow": [
      "Bash(npm run typecheck)",
      "Bash(npm run lint)",
      "Bash(npm run smoke)",
      "Bash(npm run build)",
      "Bash(npm run dev)",
      "Bash(npm run db:generate)",
      "Bash(node node_modules/typescript/bin/tsc:*)",
      "Bash(npx eslint:*)",
      "Bash(curl -s http://127.0.0.1:5173:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)"
    ],
    "deny": [
      "Edit(.wrangler/**)",
      "Write(.wrangler/**)",
      "Edit(dist/**)",
      "Write(dist/**)"
    ]
  }
}
